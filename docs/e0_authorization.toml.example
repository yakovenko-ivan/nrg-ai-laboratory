# E0 Mode 3 authorization record -- EXAMPLE / TEMPLATE (G1-S1b corrected).
#
# TWO SEPARATE FILES ARE INVOLVED. Do not merge them.
#
#  (A) MACHINE-LOCAL OPERATIONAL CONFIGURATION -> config/laboratory.local.toml
#      [e0] paths and knobs only: where the NRG checkout, build root, audit run
#      root, harness and Cantera launcher live on THIS machine. Machine-specific,
#      carries no authoritative pin, never installed as an authorization record.
#      See the commented [e0] block at the bottom of this file.
#
#  (B) OPERATOR-OWNED AUTHORIZATION RECORD -> config/e0_authorization.toml
#      (the uncommented body below). Authoritative pins, the fixed in-code
#      selectors, the researcher-approved acceptance thresholds, and the L0
#      audit scope. Installed out-of-band with mode 0600 and NEVER edited by the
#      agent.
#
# Installation:
#   install -m 600 docs/e0_authorization.toml.example config/e0_authorization.toml
#   # replace every REVIEWER_MUST_FILL_* placeholder with researcher-verified values
#   chmod 600 config/e0_authorization.toml
#
# The bridge loads only config/e0_authorization.toml. It fails closed if the
# record is absent, a symlink, malformed, missing a scope-required pin, or
# inconsistent with the fixed in-code selectors. Git does not preserve Unix mode
# 0600; set the permission explicitly after installation.
#
# SCOPE SEMANTICS (G1-S1b):
#   build      -> the source-identity pins below (commit, source_sha256,
#                 source_relative, cmake_selector, cmake_target) and nothing
#                 else. No harness, no validation config, no acceptance table.
#   validation -> build pins + harness_sha256 + validation_config_sha256 +
#                 mechanism_selector + [e0_authorization.acceptance].
#   audit      -> build pins + [e0_authorization.audit].
#
# The approved NRG commit for this verification program is
# f242e4e9a0950d3c7d6d12e2ca78f16041b652af; confirm it before use.

[e0_authorization]
# --- scope: build (also required by validation and audit) --------------------
# Full 40-hex git commit of the approved NRG checkout.
commit = "f242e4e9a0950d3c7d6d12e2ca78f16041b652af"

# 64-hex SHA-256 of the approved equilibrium source file
# package_interface/src/tests/classic_tests/0D_chemical_equilibrium_validation.f90.
source_sha256 = "9f4dee32eea2d6d8ac95fdace747084807c7dd1dcb2a9d6ede5ac186de88a21a"

# These three must equal the fixed in-code constants (_E0_SOURCE_REL,
# _E0_CMAKE_SELECTOR, _E0_CMAKE_TARGET). Do not edit them here.
source_relative = "package_interface/src/tests/classic_tests/0D_chemical_equilibrium_validation.f90"
cmake_selector = "src/tests/classic_tests/0D_chemical_equilibrium_validation.f90"
cmake_target = "package_interface"

# --- scope: validation only --------------------------------------------------
# Omit harness_sha256, validation_config_sha256, mechanism_selector and the
# [e0_authorization.acceptance] table for a BUILD-ONLY installation. A build must
# never require hashes of a harness the laboratory does not have, and inventing
# such hashes is exactly what must not happen.
harness_sha256 = "REVIEWER_MUST_FILL_SHA256_OF_PATCHED_run_validation.py"
validation_config_sha256 = "REVIEWER_MUST_FILL_SHA256_OF_validation_config.json"
mechanism_selector = "hydrogen/KEROMNES.txt"

[e0_authorization.acceptance]
# Exactly these seven researcher-approved keys are required by the validation
# scope; no extras, no defaults. Each value must be finite, nonnegative, and
# within the fixed in-code permissible range.
normalization_tolerance = 1e-6
nonnegativity_tolerance = 1e-12
element_conservation_tolerance = 1e-7
mass_conservation_tolerance = 1e-7
enthalpy_residual_tolerance = 1e-9
mole_fraction_tolerance = 5e-4
temperature_tolerance_K = 2.0

# --- scope: audit (L0 direct verification, G1-S1b) ---------------------------
# Install this table ONLY after a build produced build_manifest.json: the
# executable hash below cannot exist before the build, so until then the audit
# readiness command must report can_run = false.
#
# Required case keys are exactly:
#   id, mode, mechanism, thermo, transport,
#   mechanism_sha256, thermo_sha256, transport_sha256,
#   tp_temperature, initial_temperature, pressure, components
# id must match ^[A-Z0-9_]{2,8}$; mode is "tp" or "hp" ("all"/"crossover" are
# refused); the three file hashes are APPROVED-COMMIT BLOB hashes, not working
# tree bytes.
#
# `components` are MOLAR AMOUNTS, not fractions: they must be finite and
# positive, at most 1e6 in total. They are recorded verbatim and are not
# renormalized by this configuration; the NRG interface performs its own
# normalization and floors every species fraction at 1e-4.

#[e0_authorization.audit]
#executable_sha256 = "REVIEWER_MUST_FILL_SHA256_OF_BUILT_EXECUTABLE"
#build_commit = "f242e4e9a0950d3c7d6d12e2ca78f16041b652af"
#timeout_seconds = 120
#total_timeout_seconds = 900
#fixtures_enabled = true
#
#[[e0_authorization.audit.case]]
#id = "M1"
#mode = "tp"
#mechanism = "hydrogen/KEROMNES.txt"
#mechanism_sha256 = "REVIEWER_MUST_FILL_MECHANISM_BLOB_SHA256"
#thermo = "KEROMNES_THERMO.txt"
#thermo_sha256 = "REVIEWER_MUST_FILL_THERMO_BLOB_SHA256"
#transport = "KEROMNES_TRANSDATA.txt"
#transport_sha256 = "REVIEWER_MUST_FILL_TRANSDATA_BLOB_SHA256"
#tp_temperature = 1500.0
#initial_temperature = 300.0
#pressure = 101325.0
## H2/O2/N2 = 2 : 1 : 3.762, the exact air-ratio mixture used by the reviewed
## G1-R configuration checklist and by every matched-Cantera comparison. Keep the
## ratio verbatim: the total (6.762 mol) is intentionally not normalized here, so
## that the recorded composition is directly comparable with the reference case.
#components = [["H2", 2.0], ["O2", 1.0], ["N2", 3.762]]
#
# ===========================================================================
# (A) MACHINE-LOCAL OPERATIONAL CONFIGURATION -- config/laboratory.local.toml
#     NOT part of the authorization record. Do not copy this block into
#     config/e0_authorization.toml.
# ===========================================================================
#
# [e0]
# nrg_source_root = "/abs/path/to/NRG"                 # build/audit
# build_root = "/abs/path/outside/repo/build"          # build/audit
# equilibrium_executable = "package_interface_0D_chemical_equilibrium_validation"
# parallel_jobs = 4                                    # required, 1..64
## timeout_seconds is the bridge build/validation budget. It must satisfy
## timeout_seconds + _E0_CLEANUP_MARGIN_S (120) <= _E0_BRIDGE_TIMEOUT_S (1800),
## so the largest admissible value is 1680. A larger value is rejected by
## _e0_deadline() before anything is built.
# timeout_seconds = 1680                               # required, 1..1680
# build_type = "release"                               # optional: release|debug
# run_root = "/abs/path/outside/repo/validation"       # validation only
# harness = "/abs/path/to/tools/run_validation.py"     # validation only
# cantera_python = "/abs/path/.venv/bin/python"        # validation only, optional
# audit_run_root = "/abs/path/outside/repo/audit"      # audit only
